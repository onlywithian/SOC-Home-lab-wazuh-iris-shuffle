<!-- detections/suspicious-process.xml
 -->
<group name="windows,sysmon,">
  <rule id="100200" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(temp|downloads|appdata\\local\\temp)\\[^\\]+\.(exe|dll|ps1|vbs|js)$</field>
    <description>Process started from a temporary or downloads folder</description>
    <mitre>
      <id>T1204</id>
    </mitre>
    <group>process_creation,</group>
  </rule>
</group>

<!-- detections/suspicious-process.xml
     Corrected from the original draft:
     - base on the Sysmon process-creation group instead of rule 616 (verify the group name in your ruleset)
     - Wazuh field names are lower-case: win.eventdata.image
     - the original had two <field> checks on the same field; one regex is enough
     Starting point only: expect noise from legitimate installers, tune before relying on it. -->
<group name="windows,sysmon,">
  <rule id="100200" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(temp|downloads|appdata\\local\\temp)\\[^\\]+\.(exe|dll|ps1|vbs|js)$</field>
    <description>Process started from a temporary or downloads folder</description>
    <mitre>
      <id>T1204</id>
    </mitre>
    <group>process_creation,</group>
  </rule>

#!/bin/sh
# Wazuh integration wrapper: runs custom-iris.py with Wazuh's bundled Python.
# Place next to custom-iris.py in /var/ossec/integrations/

WPYTHON_BIN="framework/python/bin/python3"

SCRIPT_PATH_NAME="$0"
DIR_NAME="$(cd $(dirname ${SCRIPT_PATH_NAME}); pwd -P)"
SCRIPT_NAME="$(basename ${SCRIPT_PATH_NAME})"

case ${DIR_NAME} in
    */active-response/bin | */wodles*)
        if [ -z "${WAZUH_PATH}" ]; then
            WAZUH_PATH="$(cd ${DIR_NAME}/../..; pwd)"
        fi
        WPYTHON_BIN="${WAZUH_PATH}/framework/python/bin/python3"
    ;;
    */bin)
        if [ -z "${WAZUH_PATH}" ]; then
            WAZUH_PATH="$(cd ${DIR_NAME}/..; pwd)"
        fi
        WPYTHON_BIN="${WAZUH_PATH}/framework/python/bin/python3"
    ;;
    */integrations)
        if [ -z "${WAZUH_PATH}" ]; then
            WAZUH_PATH="$(cd ${DIR_NAME}/..; pwd)"
        fi
        WPYTHON_BIN="${WAZUH_PATH}/framework/python/bin/python3"
    ;;
esac

${WPYTHON_BIN} ${DIR_NAME}/${SCRIPT_NAME}.py "$@"
